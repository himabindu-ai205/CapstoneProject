# Copy this file to .env and fill in the key.
# Do not commit .env.

# Groq API key. The official agent uses openai/gpt-oss-120b on Groq's free tier.
# Limits: 30 requests/minute, 1,000 requests/day, 8,000 tokens/minute, 200,000 tokens/day.
GROQ_API_KEY=

# Gemini API key. The reviewer uses gemini-2.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SQLite path. Leave unset to use data/desk.sqlite.
DESK_DB=data/desk.sqlite

# Google Doc id from the URL, the segment after /d/. Append doc writes here.
# Leave blank until the doc exists. The button does not create a document.
GOOGLE_DOC_ID=

# Recipient for the unsent Gmail draft. Defaults to product@groww.
PULSE_DRAFT_TO=product@groww

# Folder of the Google MCP server (the one that contains dist/index.js).
# Leave blank to use the MCP Server folder next to this project.
GOOGLE_MCP_DIR=
